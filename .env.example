# Copy this file to .env and fill in the values:   copy .env.example .env
# .env is git-ignored. Never commit it.
# Use letters and digits only in passwords: quotes or $ signs break the Postgres init script.

# --- Postgres ------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
N8N_DB_PASSWORD=change-me-n8n
MONITOR_DB_PASSWORD=change-me-monitor
GRAFANA_DB_PASSWORD=change-me-grafana

# --- n8n -----------------------------------------------------------------------
# Encrypts credentials stored in n8n. Generate one in PowerShell:
#   -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_})
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
TZ=Asia/Kolkata

# --- Grafana -------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
GRAFANA_PUBLIC_URL=http://localhost:3000

# --- Alerting ------------------------------------------------------------------
# Slack incoming webhook (see docs/SETUP_SLACK.md). Leave empty to skip Slack.
SLACK_WEBHOOK_URL=

# --- Ollama (root-cause summaries) ----------------------------------------------
# Native Ollama on your PC, reached from Docker via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# llama3.1 needs:  ollama pull llama3.1   (or use one you already have, e.g. qwen3:4b)
OLLAMA_MODEL=llama3.1

# --- Drift monitor ----------------------------------------------------------------
# Base URL used in Slack links to the Evidently HTML reports
REPORT_BASE_URL=http://localhost:8010
# Keep the newest N HTML reports (each is ~6 MB)
REPORT_RETENTION=50
# Rows of simulated production traffic per monitoring run
BATCH_SIZE=400

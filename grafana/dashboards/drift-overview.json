    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts in range",
      "description": "Monitoring runs that crossed at least one threshold.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"

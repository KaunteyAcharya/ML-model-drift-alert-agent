      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model accuracy: reference vs. current",
      "description": "Performance drift. Needs actual outcomes, which in production arrive after the prediction.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "rawSql": "SELECT run_ts AS time, accuracy_ref AS \"Reference\", accuracy_cur AS \"Current batch\" FROM drift_runs WHERE $__timeFilter(run_ts) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 0,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "min": 0.6
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Malignant rate: actual vs. predicted",
      "description": "Target drift = the real outcome mix changed. Prediction drift = the model's output mix changed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "rawSql": "SELECT run_ts AS time, target_rate_ref AS \"Reference (actual)\", target_rate_cur AS \"Current (actual) - target drift\", pred_rate_cur AS \"Current (predicted) - prediction drift\" FROM drift_runs WHERE $__timeFilter(run_ts) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 0,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "PSI of the most-drifted features",
      "description": "The six features with the highest PSI in the selected time range. Red line = significant shift (PSI 0.25).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "rawSql": "SELECT fd.run_ts AS time, fd.feature AS metric, fd.psi AS value\nFROM feature_drift fd\nWHERE $__timeFilter(fd.run_ts)\n  AND fd.feature IN (SELECT feature FROM feature_drift WHERE $__timeFilter(run_ts)\n                     GROUP BY feature ORDER BY max(psi) DESC NULLS LAST LIMIT 6)\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 0,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Latest run: per-feature drift",
      "description": "Evidently statistics for each feature in the most recent run, sorted by PSI.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "rawSql": "SELECT feature AS \"Feature\", psi AS \"PSI\", kl_div AS \"KL divergence\", drift_score AS \"p-value\",\n       drifted AS \"Drifted\", ref_mean AS \"Ref mean\", cur_mean AS \"Current mean\",\n       mean_shift_pct AS \"Mean change %\", cur_missing_share AS \"Missing\"\nFROM feature_drift\nWHERE run_id = (SELECT run_id FROM drift_runs WHERE $__timeFilter(run_ts) ORDER BY run_ts DESC LIMIT 1)\nORDER BY psi DESC NULLS LAST",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PSI"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.1
                    },
                    {
                      "color": "red",
                      "value": 0.25
                    }
                  ]
                }
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Missing"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p-value"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Alerts and root-cause summaries",
      "description": "Every alert, why it fired, and the plain-English explanation n8n got from Ollama. Click Report for the Evidently HTML.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "rawSql": "SELECT run_ts AS \"Time\", alert_severity AS \"Severity\", array_to_string(alert_reasons, '; ') AS \"Why it fired\",\n       coalesce(llm_summary, '(no LLM summary yet)') AS \"Root-cause summary (Ollama)\", report_url AS \"Report\"\nFROM drift_runs WHERE $__timeFilter(run_ts) AND alert_triggered ORDER BY run_ts DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Report"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Evidently report",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*",
                      "result": {
                        "text": "open"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "text": "critical"
                      },
                      "warning": {
                        "color": "orange",
                        "text": "warning"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "monitoring-pg"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",

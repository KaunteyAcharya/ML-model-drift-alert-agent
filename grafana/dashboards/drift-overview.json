        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Share of drifted features",
      "description": "Red band = alert threshold (30%).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "rawSql": "SELECT run_ts AS time, share_drifted_features AS \"Drifted share\" FROM drift_runs WHERE $__timeFilter(run_ts) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 0,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {

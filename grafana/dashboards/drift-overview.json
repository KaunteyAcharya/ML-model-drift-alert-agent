          },
          "rawSql": "SELECT run_ts AS time, max_psi AS \"Max PSI\" FROM drift_runs WHERE $__timeFilter(run_ts) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {

{
  "uid": "drift-overview",
  "title": "Model Drift Overview",
  "tags": [
    "mlops",
    "drift",
    "evidently"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Data drift, prediction/target drift and performance for the breast-cancer classifier, written by the drift-monitor service.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Features drifted (latest run)",
      "description": "Share of the 30 input features whose distribution changed (statistical test, p < 0.05). Alert line: 30%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "rawSql": "SELECT share_drifted_features AS \"Drifted share\" FROM drift_runs WHERE $__timeFilter(run_ts) ORDER BY run_ts DESC LIMIT 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.15
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Max PSI (latest run)",
      "description": "Largest Population Stability Index across features. <0.1 stable, 0.1-0.25 moderate, >0.25 significant.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
